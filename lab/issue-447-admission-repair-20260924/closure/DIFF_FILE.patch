+					if c.Meta.TaskType != TaskInvestigate || !strings.Contains(string(c.Content), "): "+task+"\n") {
+						t.Fatalf("runner polluted card: %s", c.Content)
+					}
+				}
+			}
+			if !found {
+				t.Fatal("no outcome")
+			}
+		})
+	}

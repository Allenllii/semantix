+	if len(ticks) != 1 {
+		t.Fatalf("ticks=%d, want 1", len(ticks))
+	}
+	if len(schedTuner.values) != 1 || len(prefetchTuner.values) != 1 {
+		t.Fatalf("applies sched=%v prefetch=%v", schedTuner.values, prefetchTuner.values)
+	}

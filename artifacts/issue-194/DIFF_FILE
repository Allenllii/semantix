+func (a *Agent) observePrefetchTransitions(calls []sched.ToolCallInfo) {
+	if a.prefetcher == nil || len(calls) == 0 {
+		return
+	}
+	a.prefetchMu.Lock()
+	defer a.prefetchMu.Unlock()
+	prev := a.prefetchLast
+	for _, call := range calls {
+		if prev != "" {
+			a.prefetcher.Observe(prev, call.Name, call.ReadOnly)
+		}
+		prev = call.Name
+	}
+	a.prefetchLast = prev

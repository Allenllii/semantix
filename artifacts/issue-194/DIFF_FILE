+
+func mean(rs []row, f func(row) float64) float64 {
+	var s float64
+	for _, r := range rs {
+		s += f(r)
+	}
+	return s / float64(len(rs))
+}
+func f3(v float64) string { return strconv.FormatFloat(v, 'f', 3, 64) }
+func pass(ok bool) string {
+	if ok {
+		return "PASS"
+	}
+	return "FAIL"
+}

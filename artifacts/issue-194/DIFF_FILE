+	if err := json.Unmarshal(ticks[0].Data, &tick); err != nil {
+		t.Fatal(err)
+	}
+	if !json.Valid(tick.ParamsJSON) || ticks[0].SessionID != "s1" || ticks[0].Turn != 2 {
+		t.Fatalf("bad tick: %#v", ticks[0])
+	}
+	loop.Close()
